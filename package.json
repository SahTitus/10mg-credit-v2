{
  "name": "10mg-credit-v2",
  "version": "2.0.0",
  "private": true,
  "description": "10mg Credit V2 — Enterprise White-Label Lending Application",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:strict": "eslint src scripts eslint.config.mjs next.config.mjs postcss.config.mjs vitest.config.ts --max-warnings=0",
    "lint:fix": "eslint src scripts eslint.config.mjs next.config.mjs postcss.config.mjs vitest.config.ts --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.cjs\" \".vscode/*.json\" \"*.{json,mjs,ts,md,yml}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.cjs\" \".vscode/*.json\" \"*.{json,mjs,ts,md,yml}\"",
    "typecheck": "tsc --noEmit",
    "check:file-size": "node scripts/check-file-size.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "15.5.29",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
